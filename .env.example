# 本地开发用的环境变量模板。复制成 .env 后填入真实值：
#   cp .env.example .env
#
# .env 已被 gitignore 忽略，绝不会提交到仓库——换机器时必须手动重建。
# 生产环境的值在 Render → Environment 里，这个文件只管本地开发。
#
# 一个也不填也能启动：AI 相关功能会报错，其余（背单词、语法、注册登录）照常用。

# ---- 本地服务 ----
PORT=3001

# ---- 会话签名密钥（必填）----
# 不填会退回代码里的默认值，任何人都能伪造登录态。
# 生成一个：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---- 数据库 ----
# 不填就用本地文件 data/db.json（仅适合本地开发）。
# 生产必须填 MongoDB 连接串，否则每次部署数据清零。
MONGODB_URI=

# ---- AI 三级兜底：Groq → OpenRouter → 国内大模型 ----
SF_API_KEY=
OPENROUTER_API_KEY=
DOMESTIC_API_KEY=

# ---- 管理员账号名 ----
ADMIN_USERNAME=
SUPER_ADMIN_USERNAME=administrator

# ---- 短信服务 ----
# 留空 = 测试模式，验证码直接返回给前端，方便本地注册测试。
# 生产必须配，否则手机验证形同虚设。
SMS_PROVIDER=

# ---- AI 视频通话（Tavus）----
# 不填这两个，视频通话功能整体隐藏，其余功能不受影响。
TAVUS_API_KEY=
TAVUS_FACE_ID=
# 多位"面对面"老师：形象 ID 已经写在 data/personas.json 里了（Tavus 公共形象库
# Stock Replica，各账号通用、不是密钥），开箱即用，不用配任何东西。
# 只有想换成自己录的形象、或者 Stock 的 ID 变了，才需要在这里覆盖：
#   TAVUS_FACE_<人设id大写>=r1234567890
# 人设 id 见 data/personas.json：dawn / steph / lucy / olivia
#                              ruby / lee / jamie / danny
# TAVUS_FACE_DAWN=r1234567890
# 同理还能换 persona：TAVUS_PAL_DAWN=p...
# ⚠️ 当前这批是 PRO 形象。如果套餐不含 PRO、接通报错，就在这里把 faceId 覆盖成
#    非 PRO 的形象，或者 git 回退 personas.json 的 v2 版本。

# 以下有默认值，按 Tavus 套餐调整（当前 Builder：175分钟/月、并发3路）
# AVATAR_GLOBAL_MONTHLY_MINUTES=175
# AVATAR_MONTHLY_MINUTES=1
# AVATAR_MAX_CONCURRENT=3

# ---- 登录页的免费视频测评 ----
# 未登录的访客也能测，所以这是全站唯一一个不登录也会产生 Tavus 账单的入口。
# 成本按访客数线性涨：Starter 套餐 100 分钟 ≈ 100 个人测完就用光了。
# 流量涨上来之前，先把 AVATAR_GLOBAL_MONTHLY_MINUTES 设成你愿意为这个月付的上限——
# 那是硬顶，撞到就停发，不会悄悄冲进超额计费。
# PLACEMENT_VIDEO=off        # 整个关掉（不配就是开着）
# PLACEMENT_VIDEO_SECONDS=60 # 单次时长
# PLACEMENT_VIDEO_PER_IP=2   # 每个 IP 每月能免费测几次（默认 2）
#
# 给指定 IP 开更高上限（自测用）。写法 `IP=次数`，逗号分隔，
# 次数可省略（省略按 10 次）。分隔符是 = 不是 :，因为 IPv6 地址本身全是冒号。
# 自己的出口 IP 用超管身份打开 /api/health 看 yourIp；
# 同一页的 placementYourLimit 能确认这条配生效了没有（家宽 IP 会变，隔段时间要重看）。
# 全站月度硬顶对例外 IP 一样生效——那道闸门守的是账单，不是防滥用。
# PLACEMENT_VIDEO_IP_LIMITS=203.0.113.9=10

# 调试窗口：配了日期的话，到期之前不限每 IP 次数。现在是关的（调试期已结束）。
# 做成自动到期是因为这类临时放开最容易被忘掉。要再放开就填一个将来的日期，
# 提前结束就配成空值。窗口开着时，启动日志和 /api/health 的 warnings 都会提醒。
# 放开的只是每 IP 次数，全站月度硬顶照常生效，账单上限没动。
# PLACEMENT_VIDEO_OPEN_UNTIL=2026-10-20

# 测评考官单独用哪张脸。默认已经是 Luna（r983d5889432，写在代码里）；
# 配成空值则退回「跟老师列表的第一位」。和「选老师」分开，
# 想给测评换张脸不用去改八位老师的排序。id 在 Tavus 后台 FACES 里看，r 开头。
# 八位老师共用同一个 PAL（音色），所以一般只配 FACE 就行，声音不变。
# 配完用超管打开 /api/health 看 placementFace 确认生效。
# PLACEMENT_FACE_ID=r1234567890
# PLACEMENT_PAL_ID=p1234567890

# ---- 支付与第三方登录（本地开发通常不需要）----
ZPAY_PID=
ZPAY_KEY=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
QQ_APP_ID=
QQ_APP_KEY=
